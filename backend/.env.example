# X-MMHF Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your actual .env to version control

# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-signing-key-at-least-32-characters-long

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development (auto-created):
DATABASE_URL=sqlite:///./hiring_intelligence.db
# PostgreSQL for production (set in Render dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Services ─────────────────────────────────────────────────────────────
# Google Gemini API key — get from: https://aistudio.google.com/app/apikey
# OPTIONAL: system falls back to rule-based XAI if not set
GEMINI_API_KEY=

# GitHub Personal Access Token — get from: https://github.com/settings/tokens
# OPTIONAL: raises GitHub API rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=

# ── Token Configuration ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
